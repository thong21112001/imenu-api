# Port chay server API
PORT=3001

# Moi truong (development | production | test)
NODE_ENV=development

# Chuoi ket noi MongoDB
MONGODB_URL=mongodb://localhost:27017/imenu-db
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Cau hinh JWT Authentication
JWT_SECRET=your_jwt_signing_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Danh sach Allowed Origins cho CORS (ngan cach boi dau phay)
CORS_ORIGINS=http://localhost:3000,http://localhost:3003,http://localhost:3004,http://localhost:3005

# Duong dan Swagger UI
SWAGGER_PATH=api-docs

# Tai khoan Super Admin (Quan tri toan he thong - Cap cao nhat)
SUPERADMIN_EMAIL=
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
SUPERADMIN_FULLNAME=
SUPERADMIN_PHONE=

# Mat khau khoi tao cac tai khoan demo (owner, manager, cashier, kitchen, waiter)
DEMO_USER_PASSWORD=your_demo_password_here

# Mat khau mac dinh cho nhan vien kinh doanh (Sales Rep) khoi tao
DEFAULT_SALES_PASSWORD=your_sales_password_here

# Co bat/tat gioi han sua du lieu cho tai khoan demo (true: Staging/Demo | false: Production)
ENABLE_DEMO_RESTRICTIONS=false

